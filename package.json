{
  "name": "web-tops",
  "version": "0.3.0",
  "private": true,
  "description": "Web-TOPS: the Web Testing and Optimization Protocol Suite and its webtops CLI",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/config/index.ts",
  "types": "./src/config/index.ts",
  "exports": {
    ".": {
      "types": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./schema/web-tops.schema.json": "./schema/web-tops.schema.json",
    "./schema/gate-report.schema.json": "./schema/gate-report.schema.json",
    "./schema/baseline.schema.json": "./schema/baseline.schema.json",
    "./schema/core.schema.json": "./schema/core.schema.json",
    "./schema/law.schema.json": "./schema/law.schema.json",
    "./eslint": {
      "types": "./src/presets/eslint.d.ts",
      "default": "./src/presets/eslint.js"
    },
    "./stylelint": {
      "types": "./src/presets/stylelint.d.ts",
      "default": "./src/presets/stylelint.js"
    },
    "./depcruise": {
      "types": "./src/presets/depcruise.d.cts",
      "default": "./src/presets/depcruise.cjs"
    },
    "./tsconfig/strict.json": "./src/presets/tsconfig/strict.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "webtops": "src/cli/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-support*.ts",
    "schema",
    "laws",
    "config",
    "profiles",
    "packages/eslint-plugin-webtops/package.json",
    "packages/eslint-plugin-webtops/dist"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": "^22.23.4 || ^24.15.0 || >=26"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prepare": "tsc -p packages/eslint-plugin-webtops/tsconfig.build.json",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --sequence.shuffle",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "secretlint": "14.0.1",
    "stylelint": "18.0.0",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
