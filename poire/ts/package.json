{
  "name": "poire-ts",
  "version": "0.2.0",
  "private": true,
  "description": "TS-POIRE 0.2 checked exemplars: healthy forms, and counter-examples held to their detectors.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    "./order": {
      "types": "./src/order.ts",
      "default": "./src/order.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "default": "./src/http.ts"
    },
    "./pool": {
      "types": "./src/pool.ts",
      "default": "./src/pool.ts"
    },
    "./anomalies": {
      "types": "./src/anomalies.ts",
      "default": "./src/anomalies.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26"
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --sequence.shuffle",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "secretlint": "14.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "web-tops": "link:../.."
  }
}
