{
  "name": "astro-site-example",
  "version": "0.0.0",
  "private": true,
  "description": "A small static site in the astro-site class, with Tailwind CSS: it builds into dist/ and ships no page JavaScript.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26"
  },
  "scripts": {
