{
  "name": "node-service-example",
  "version": "0.0.0",
  "private": true,
  "description": "A small notes service in the node-service class: the example that gates itself with the kit's own source.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --sequence.shuffle",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "web-tops": "link:../.."
  }
}
