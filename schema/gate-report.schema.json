{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedronite.com/schemas/web-tops/0.3/gate-report.schema.json",
  "title": "gate report (.web-tops/report.json)",
  "type": "object",
  "required": [
    "report_version",
    "protocol",
    "class",
    "enforce",
    "enforced",
    "max_tier",
    "only",
    "subject",
    "run",
    "counts",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^0\\.3\\.[0-9]+$"
    },
    "class": {
      "enum": [
        "ts-library",
        "ui-components",
        "astro-site",
        "web-app",
        "node-service",
        "cli",
        "workspace-root",
        "config-only"
      ]
    },
    "enforce": {
      "$ref": "core.schema.json#/$defs/enforce"
    },
    "enforced": {
      "type": "boolean"
    },
    "max_tier": {
      "$ref": "#/$defs/tier"
    },
    "counts": {
      "type": "object",
      "required": ["in_range", "ran", "failed", "not_evaluated", "required_not_evaluated"],
      "additionalProperties": false,
      "properties": {
        "in_range": {
          "type": "integer",
          "minimum": 0
        },
        "ran": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "required_not_evaluated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "hygiene"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "tests"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "coverage"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "crap"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "mutation"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "build-output"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "laws"
              }
            },
            "required": ["id"]
          }
        }
      ]
    },
    "only": {
      "type": ["string", "null"]
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": ["string", "null"]
    },
    "keep_going": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    },
    "crap_scope": {
      "enum": ["all", "diff"]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "message"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "report_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "laws": {
      "type": "object",
      "description": "N of M laws judged for the class: M the laws it requires, N those a reader judged. Recounted from the laws layer's own findings (rule law/W-NN, required).",
      "required": ["class", "of", "judged", "refused", "not_evaluated"],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "of": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "not_evaluated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["package", "root"],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["sha", "bun", "node", "tools", "seed"],
      "additionalProperties": false,
      "properties": {
        "sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "bun": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "node": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "seed": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "layer": {
      "type": "object",
      "required": ["id", "gate", "tier", "verdict", "required", "findings", "metrics"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "gate": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            {
              "const": "laws"
            }
          ]
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "verdict": {
          "$ref": "core.schema.json#/$defs/verdict"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "verdict": {
            "enum": ["skip", "not-run"]
          }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "reason": true
        },
        "required": ["reason"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "not": {
                  "const": "mutation"
                }
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "survivor": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "hygiene"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "propertyNames": {
                  "enum": ["findings"]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "tests"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "coverage"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "propertyNames": {
                  "enum": ["coverage"]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "crap"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "propertyNames": {
                  "enum": ["crap"]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "mutation"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "propertyNames": {
                  "enum": ["mutation"]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "build-output"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "propertyNames": {
                  "enum": ["pages"]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "laws"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "metrics": {
                "propertyNames": {
                  "enum": ["findings"]
                },
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "required": ["tool", "rule", "law", "verdict", "message", "file", "line", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "$ref": "core.schema.json#/$defs/verdict"
        },
        "message": {
          "type": "string"
        },
        "ack": {
          "type": "object",
          "required": ["source", "reason"],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": ["comment", "ledger"]
            },
            "reason": {
              "$ref": "#/$defs/reason"
            }
          }
        },
        "file": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "required": {
          "type": "boolean"
        },
        "survivor": {
          "$ref": "#/$defs/survivor"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "law": {
          "type": ["string", "null"],
          "pattern": "^W-[0-9]{2}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^fp1:[0-9a-f]{16}$"
        }
      },
      "dependentSchemas": {
        "ack": {
          "properties": {
            "verdict": {
              "const": "pass"
            }
          }
        }
      },
      "if": {
        "properties": {
          "line": {
            "type": "integer"
          }
        },
        "required": ["line"]
      },
      "then": {
        "properties": {
          "file": {
            "type": "string"
          }
        }
      }
    },
    "survivor": {
      "type": "object",
      "required": ["file", "function", "mutator", "original", "replacement", "occurrence"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "mutator": {
          "type": "string",
          "minLength": 1
        },
        "original": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "name", "line", "complexity", "coverage", "crap"],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "complexity": {
                "type": "integer",
                "minimum": 1
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "crap": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "lines_found", "lines_hit"],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lines_found": {
                "type": "integer",
                "minimum": 0
              },
              "lines_hit": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "file", "count"],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "mutation": {
          "type": "object",
          "required": [
            "killed",
            "timeout",
            "survived",
            "no_coverage",
            "runtime_error",
            "compile_error",
            "ignored"
          ],
          "additionalProperties": false,
          "properties": {
            "killed": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "type": "integer",
              "minimum": 0
            },
            "survived": {
              "type": "integer",
              "minimum": 0
            },
            "no_coverage": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_error": {
              "type": "integer",
              "minimum": 0
            },
            "compile_error": {
              "type": "integer",
              "minimum": 0
            },
            "ignored": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["route", "bytes"],
            "additionalProperties": false,
            "properties": {
              "route": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "tool": {
      "enum": [
        "astro",
        "attw",
        "audit",
        "biome",
        "bun",
        "dependency-cruiser",
        "eslint",
        "knip",
        "prettier",
        "publint",
        "secretlint",
        "stryker",
        "stylelint",
        "tsc",
        "vitest",
        "webtops"
      ]
    }
  }
}
