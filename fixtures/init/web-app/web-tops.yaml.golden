# Written by `webtops init` (WEB_TOPS.md sections 4 and 9). Under `hard`, only crap, mutation, build
# output and laws may be off for a class that maps them: they are `enabled: false` with a reason that
# says why. A layer the class does not map is off with the class as the reason.
protocol: <protocol>
version: 1.2.3
package: demo
class: web-app
enforce: hard
baseline: .web-tops/baseline.json
toolchain:
  typescript: 6.0.3
  runtime: bun
gates:
  hygiene:
    eslint:
      config: eslint.config.js
    format:
      tool: prettier
    astro_check:
      enabled: false
      reason: "not mapped for class: this project lists no astro dependency"
    stylelint: {}
    audit:
      fail_on: high
  tests:
    runner: vitest
    shuffle: true
  coverage:
    lines_floor: 70
  crap:
    cap: 6
    scope: diff
    complexity:
      nullish_discount: true
    enabled: false
    reason: "milestone M2: native CRAP lands in M2"
  mutation:
    engine: stryker
    scope: diff
    base: origin/main
    unexplained_survivors_max: 2
    ledger: .web-tops/survivors.yaml
    enabled: false
    reason: "milestone M2: mutation testing lands in M2"
layers:
  size_limit:
    tier: 1
    enabled: false
    reason: "not mapped for class: an app publishes no package entries"
  package_exports:
    tier: 1
    enabled: false
    reason: "not mapped for class: an app publishes no package exports"
  html_validate:
    enabled: false
    reason: "not set up by `webtops init`: it writes no `build` and installs no html-validate"
  axe:
    enabled: false
    reason: "not set up by `webtops init`: it writes no `build` and installs no @axe-core/playwright"
  rendered:
    enabled: false
    reason: "not built yet: there is no reader for rendered checks"
  themes:
    enabled: false
    reason: "not built yet: there is no theme reader"
  custom: []
laws:
  select: default
  ack_ledger: .web-tops/acks.yaml
  enabled: false
  reason: "milestone M3: the laws layer lands in M3"
report:
  path: .web-tops/report.json
