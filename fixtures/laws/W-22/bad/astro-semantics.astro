---
const handler = () => undefined;
---
<!-- expect: astro/jsx-a11y/alt-text -->
<img src="a.png" />
<!-- expect: astro/jsx-a11y/anchor-has-content -->
<a href="/x"></a>
<!-- expect: astro/jsx-a11y/anchor-is-valid -->
<a href="#">go</a>
<!-- expect: astro/jsx-a11y/aria-activedescendant-has-tabindex -->
<div aria-activedescendant="item"></div>
<!-- expect: astro/jsx-a11y/aria-props -->
<div aria-foo="x"></div>
<!-- expect: astro/jsx-a11y/aria-proptypes -->
<div aria-hidden="yes"></div>
<!-- expect: astro/jsx-a11y/aria-role -->
<div role="datepicker"></div>
<!-- expect: astro/jsx-a11y/aria-unsupported-elements -->
<meta charset="UTF-8" aria-hidden="true" />
<!-- expect: astro/jsx-a11y/autocomplete-valid -->
<input type="text" autocomplete="foo" />
<!-- expect: astro/jsx-a11y/click-events-have-key-events, astro/jsx-a11y/no-static-element-interactions -->
<div onClick={handler}>go</div>
<!-- expect: astro/jsx-a11y/heading-has-content -->
<h1></h1>
<!-- expect: astro/jsx-a11y/html-has-lang -->
<html></html>
<!-- expect: astro/jsx-a11y/iframe-has-title -->
<iframe src="a"></iframe>
<!-- expect: astro/jsx-a11y/img-redundant-alt -->
<img src="a.png" alt="image of a dog" />
<!-- expect: astro/jsx-a11y/click-events-have-key-events, astro/jsx-a11y/interactive-supports-focus -->
<div role="button" onClick={handler}>go</div>
<!-- expect: astro/jsx-a11y/label-has-associated-control -->
<label>Name</label>
<!-- expect: astro/jsx-a11y/media-has-caption -->
<video src="a.mp4"></video>
<!-- expect: astro/jsx-a11y/mouse-events-have-key-events, astro/jsx-a11y/no-static-element-interactions -->
<div onMouseOver={handler}></div>
<!-- expect: astro/jsx-a11y/no-access-key -->
<div accesskey="a"></div>
<!-- expect: astro/jsx-a11y/no-autofocus -->
<input autofocus />
<!-- expect: astro/jsx-a11y/no-distracting-elements -->
<marquee>go</marquee>
<!-- expect: astro/jsx-a11y/no-interactive-element-to-noninteractive-role -->
<button role="img">go</button>
<!-- expect: astro/jsx-a11y/click-events-have-key-events, astro/jsx-a11y/no-noninteractive-element-interactions -->
<h2 onClick={handler}>go</h2>
<!-- expect: astro/jsx-a11y/no-noninteractive-element-to-interactive-role -->
<h3 role="button">go</h3>
<!-- expect: astro/jsx-a11y/no-noninteractive-tabindex -->
<article tabindex="0"></article>
<!-- expect: astro/jsx-a11y/no-redundant-roles -->
<button role="button">go</button>
<!-- expect: astro/jsx-a11y/no-static-element-interactions -->
<span onKeyDown={handler}>go</span>
<!-- expect: astro/jsx-a11y/role-has-required-aria-props -->
<div role="checkbox"></div>
<!-- expect: astro/jsx-a11y/role-supports-aria-props -->
<div role="button" aria-checked="true">go</div>
<!-- expect: astro/jsx-a11y/scope -->
<div scope="col"></div>
<!-- expect: astro/jsx-a11y/no-noninteractive-tabindex, astro/jsx-a11y/tabindex-no-positive -->
<div tabindex="1"></div>
