<h1>Title</h1>
<iframe src="a" title="A map"></iframe>
<video src="a.mp4"><track kind="captions" src="a.vtt" /></video>
<div role="button" tabindex="0" onClick={handler} onKeyDown={handler}>go</div>
<div role="checkbox" aria-checked="false" tabindex="0"></div>
<input type="text" autocomplete="email" />
<div aria-hidden="true"></div>
<table><tr><th scope="col">A</th></tr></table>
<html lang="en"></html>
